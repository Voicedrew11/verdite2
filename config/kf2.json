{
  // King's Field II (NTSC-J, SLPS-00069) - From Software, 1995-07-21
  // Config schema: tools/RecompOne/RecompOne.Recompiler/Config/ConfigLoader.cs
  // JSON comments and trailing commas are accepted by the loader.
  "game": {
    "id": "SLPS-00069",
    "name": "KingsField2",
    "output": "../generated"
  },

  // Disc image. Must be a .cue (with its .bin alongside). Supply your own dump.
  "cue": "../disc/KingsField2.cue",

  // Function map for the main boot executable. Generated by linear sweep --
  // see NOTES.md. The boot EXE itself is discovered automatically from SYSTEM.CNF,
  // so there is no filename to set here.
  "funcMap": "funcmaps/main.json",

  // Address of the game's main() in hex, once identified. Optional.
  // "main": "0x800xxxxx",

  // Overlays (map/level code loaded off-disc at runtime). KF2 streams data per
  // area; any overlay that contains *code* must be listed here. Populate after
  // inspecting the disc filesystem -- see NOTES.md step 4.
  "overlays": [],

  // Functions to replace with no-op stubs, and functions to skip entirely.
  "stubs": [],
  "ignored": [],

  // Hand-written C# replacements for recompiled functions.
  "patches": [],

  // Diagnostics. Turn these on when a function misbehaves -- they make the
  // generated C# much larger, so keep them off for normal builds.
  "debug": false,
  "addressComments": false,
  "disasmComments": false
}
