{
  // King's Field (NTSC-U, SLUS-00158) -- the North American release of
  // King's Field II (JP, SLPS-00069). From Software, 1995.
  // Config schema: tools/RecompOne/RecompOne.Recompiler/Config/ConfigLoader.cs
  // JSON comments and trailing commas are accepted by the loader.
  //
  // NUMBER BASES DIFFER between this file and the CLI:
  //   here : "base" is a hex STRING; "size"/"skip"/"offset"/"lba" are decimal numbers.
  //   CLI  : -size/-skip/-offset are HEX; -lba is decimal.
  "game": {
    "id": "SLUS-00158",
    "name": "KingsField2",
    "output": "../generated"
  },

  "cue": "../disc/KingsField2.cue",

  // The boot executable named by SYSTEM.CNF (SLUS_001.58) is discovered
  // automatically. It is only 2 KiB of code at 0x80010000 -- a loader stub whose
  // job is to pull in one of the three real executables below.
  "funcMap": "funcmaps/main.json",

  // OPEN.EXE, GAME.EXE and END.EXE all load at 0x80011000, so they are mutually
  // exclusive: only one is resident at a time (title/intro, main game, ending).
  // That is exactly what the overlay system is for.
  //
  // ResolveOverlay reads these as RAW FILE BYTES and does not parse the PS-X EXE
  // header, so each needs "skip": 2048 to step over the 0x800-byte header.
  // "base" is the header's text address, read with scripts/extract_file.py.
  "overlays": [
    // Each overlay's entry point comes from its PS-X EXE header and must be
    // declared explicitly: the recompiler auto-adds the entry point only for the
    // main executable, and the linear sweep did not land a function start on any
    // of these three. Without them, BIOS Exec jumps to an address the dispatcher
    // has no function for and the run dies with "unmapped call".
    {
      "name": "open",
      "file": "OPEN.EXE",
      "base": "0x80011000",
      "skip": 2048,
      "funcMap": "funcmaps/open.json",
      "functions": [
        { "address": "0x80013DB8", "name": "open_entry" }
      ]
    },
    {
      "name": "game",
      "file": "GAME.EXE",
      "base": "0x80011000",
      "skip": 2048,
      "funcMap": "funcmaps/game.json",
      "functions": [
        { "address": "0x8004A628", "name": "game_entry" }
      ]
    },
    {
      "name": "end",
      "file": "END.EXE",
      "base": "0x80011000",
      "skip": 2048,
      "funcMap": "funcmaps/end.json",
      "functions": [
        { "address": "0x80011CB4", "name": "end_entry" }
      ]
    }
  ],

  // CD/COM/*.T and OP/*.S are data and streamed media, not code -- they stay out
  // of the overlay list and are read by the runtime through the CD interface.

  "stubs": [],
  "ignored": [],

  // PSY-Q SDK functions routed to the runtime's HLE implementations.
  //
  // SdkPatches.cs binds these by exact NAME, and a linear sweep produces no
  // names, so every SDK call has to be mapped by address here instead.
  //
  // VSync is the one that matters most: Runtime.PresentFrame() has exactly one
  // caller in the whole runtime -- the HLE LibEtc.VSync -- so until this is
  // mapped, no frame is ever pushed to the window no matter what the game draws.
  // DispatchIrq also runs from PresentFrame, so interrupt-driven waits (the CD
  // library included) cannot make progress either.
  //
  // Identified by contract fingerprint rather than by name: VSync(mode) returns a
  // counter when mode < 0, returns early when mode == 1, and otherwise waits.
  // Exactly one function per overlay matches, each 79 lines of generated C# with
  // identical structure -- the same statically linked routine in all three.
  // Addresses differ per overlay because each executable is linked separately.
  "patches": [
    { "overlay": "open", "address": "0x8001EB88",
      "target": "RecompOne.Runtime.Sdk.LibEtc.VSync", "mode": "replace" },
    { "overlay": "game", "address": "0x8005FCC8",
      "target": "RecompOne.Runtime.Sdk.LibEtc.VSync", "mode": "replace" },
    { "overlay": "end", "address": "0x8001B154",
      "target": "RecompOne.Runtime.Sdk.LibEtc.VSync", "mode": "replace" },

    // CdInit -- where boot stalls. The raw routine retries a low-level init four
    // times, then installs the sync/ready/read callbacks; the init never reports
    // success against the emulated drive, so it spins.
    //
    // Identified dynamically: PSY-Q reaches I/O through a base pointer in a
    // global rather than a literal address, so static scans find nothing. Tracing
    // the first access to the CD registers (0x1F801800-03) named the calling
    // function, and its failure string reads "CdInit: Init failed".
    { "overlay": "open", "address": "0x8001AD90",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdInit", "mode": "replace" },
    { "overlay": "game", "address": "0x8004C340",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdInit", "mode": "replace" },
    { "overlay": "end", "address": "0x8001735C",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdInit", "mode": "replace" },

    // The CdControl family. All three variants are thin wrappers that mask the
    // command byte and delegate to a shared internal command-write, so they are
    // told apart by what they pass it: CdControlF sends no result buffer and
    // sets the async flag, CdControlB issues the command and then waits (which
    // is what identifies CdSync), and plain CdControl does neither.
    { "overlay": "open", "address": "0x8001B18C",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControl", "mode": "replace" },
    { "overlay": "open", "address": "0x8001B1B0",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControlF", "mode": "replace" },
    { "overlay": "open", "address": "0x8001B1D8",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControlB", "mode": "replace" },
    { "overlay": "open", "address": "0x8001BBCC",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdSync", "mode": "replace" },

    { "overlay": "game", "address": "0x8004AF48",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControl", "mode": "replace" },
    { "overlay": "game", "address": "0x8004AF6C",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControlF", "mode": "replace" },
    { "overlay": "game", "address": "0x8004AF94",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControlB", "mode": "replace" },
    { "overlay": "game", "address": "0x8004B988",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdSync", "mode": "replace" },

    { "overlay": "end", "address": "0x80017758",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControl", "mode": "replace" },
    { "overlay": "end", "address": "0x8001777C",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControlF", "mode": "replace" },
    { "overlay": "end", "address": "0x800177A4",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControlB", "mode": "replace" },
    { "overlay": "end", "address": "0x80018198",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdSync", "mode": "replace" },

    // CdRead(sectors, buf, mode). Identified by how it derives the DMA transfer
    // length from the mode's sector-size bits (A2 & 0x30), selecting 0x200,
    // 0x249 or 0x246 words -- 2048, 2340 or 2328 bytes. Unique per overlay.
    { "overlay": "open", "address": "0x8001B244",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdRead", "mode": "replace" },
    { "overlay": "game", "address": "0x8004B000",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdRead", "mode": "replace" },
    { "overlay": "end", "address": "0x80017810",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdRead", "mode": "replace" },

    // CdReady(mode, result) and CdGetSector(addr, nword) -- the polled read path.
    //
    // Once the intro is over, OPEN.EXE loads OP/OPU.D with its own sector loop:
    // CdControl(CdlSetmode, 0x80), CdControl(CdlReadN, &loc), then per sector
    // `while (CdReady(0,0) != CdlDataReady)` followed by CdGetSector(buf, 0x200).
    // Neither is a callback, so libcdstream and the DMA-callback patch do not
    // cover it, and the raw routines cannot work: CdReady spins on a global that
    // only libcd's IRQ handler writes, and a static recompilation never runs one.
    // That spin is where the game hung after the movie -- no VSync, no CD command,
    // nothing in any log channel.
    //
    // Identified from the thunk bodies: CdReady tail-calls the internal wait loop
    // (0x8001BC7C in `open`) that polls the intr-result global, copies 8 result
    // bytes when it is set and, when mode == 0, loops forever otherwise;
    // CdGetSector tail-calls the routine that programs DMA channel 3 from the CD
    // FIFO (D3_MADR = addr, D3_BCR = nword | 0x10000, D3_CHCR = 0x11000000) and
    // returns success as (result < 1).
    //
    // Both are 8-instruction thunks and match in several places, so the other two
    // overlays come from the delta the unambiguous rows of the same object agree
    // on (game = open + 0x2FDBC, end = open - 0x3A34 -- the delta CdControl,
    // CdRead and CdGetSector itself all share). Confirmed by the call each thunk
    // makes: game's lands on 0x8004BA38 and end's on 0x80018248, both exactly the
    // internal wait loop carried across by the same offset. Note CdInit is *not*
    // at this delta (+0x315B0): libcd is split over several objects.
    { "overlay": "open", "address": "0x8001AF5C",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdReady", "mode": "replace" },
    { "overlay": "open", "address": "0x8001B224",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdGetSector", "mode": "replace" },

    { "overlay": "game", "address": "0x8004AD18",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdReady", "mode": "replace" },
    { "overlay": "game", "address": "0x8004AFE0",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdGetSector", "mode": "replace" },

    { "overlay": "end", "address": "0x80017528",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdReady", "mode": "replace" },
    { "overlay": "end", "address": "0x800177F0",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdGetSector", "mode": "replace" },

    // CdReadSync(mode, result) -- the other half of the same problem, and where
    // GAME.EXE hung on the "now loading" screen. libcd's own file reader is
    //     CdRead(...); while (CdReadSync(1, 0) > 0) ;
    // and CdReadSync returns a sectors-remaining counter that only the CD
    // interrupt decrements, so with no interrupt path the loop never ends. In
    // OPEN.EXE the same routine happened to read that counter as 0 and fell
    // straight through, which is why the intro survived without this and the
    // main game did not -- a reminder that an unmapped SDK wait can look fine
    // purely by accident.
    //
    // Same 8-instruction thunk family as CdReady, resolved the same way: the
    // internal it forwards to (open 0x8001C268, 47 instructions) matches
    // uniquely across the three overlays, and each thunk lands on it at the
    // object's delta -- 0x8004C024 in `game`, 0x80018834 in `end`.
    { "overlay": "open", "address": "0x8001AF7C",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdReadSync", "mode": "replace" },
    { "overlay": "game", "address": "0x8004AD38",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdReadSync", "mode": "replace" },
    { "overlay": "end", "address": "0x80017548",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdReadSync", "mode": "replace" },

    // ---- libgpu -------------------------------------------------------------
    //
    // The whole PSY-Q GPU library is linked at a constant offset between the
    // three executables: game = open + 0x4A7A0, end = open - 0x22F8. Every
    // address below was found in `open` and carried across by matching the
    // functions' relocation-independent instruction shape, so all three columns
    // are the same routine (scripts/find_libgpu.py re-derives the whole table).
    //
    // libgpu is two layers. The public API (0x80015A64.. in `open`) never
    // touches hardware directly: it dispatches through a driver table at
    // 0x8003D610 whose 15 slots are the routines that do (_ctl writes GP1, _dma
    // programs DMA channel 2 in linked-list mode, _otc uses channel 6, and so
    // on). Only the public layer is patched -- the driver layer is what the
    // patched functions replace, and the runtime already emulates the registers
    // it would have written.
    //
    // Identification, in order of how much it pins things down:
    //   PutDispEnv  computes hStart = scrX*10 + 0x260 and clamps it to
    //               [0x1F4, 0xCDA], the same two constants the runtime's HLE
    //               PutDispEnv uses; it ends by writing GP1(0x08) and copying
    //               the 20-byte DISPENV to the current-env global.
    //   PutDrawEnv  builds the DR_ENV packet at env+0x1C -- which is where the
    //               packet sits in a 92-byte DRAWENV -- sends it through the
    //               driver's _dma slot, then copies 0x5C bytes to the current
    //               draw env and returns the argument.
    //   DrawOTag    calls the driver's _dma slot (the one that writes D2_MADR /
    //               D2_BCR=0 / D2_CHCR=0x01000401) with the ordering table.
    //   DrawSync    tail-calls the driver slot that polls D2_CHCR and GPUSTAT
    //               and prints "GPU timeout:QUE=(%2d,%2d)..." on expiry.
    //
    // GetDrawEnv and GetDispEnv have zero call sites in all three overlays, so
    // nothing reads the copies the HLE versions do not write.
    { "overlay": "open", "address": "0x80016078",
      "target": "RecompOne.Runtime.Sdk.LibGpu.DrawOTag", "mode": "replace" },
    { "overlay": "open", "address": "0x80015E04",
      "target": "RecompOne.Runtime.Sdk.LibGpu.DrawSync", "mode": "replace" },
    { "overlay": "open", "address": "0x800160D0",
      "target": "RecompOne.Runtime.Sdk.LibGpu.PutDrawEnv", "mode": "replace" },
    { "overlay": "open", "address": "0x800161F0",
      "target": "RecompOne.Runtime.Sdk.LibGpu.PutDispEnv", "mode": "replace" },

    { "overlay": "game", "address": "0x80060818",
      "target": "RecompOne.Runtime.Sdk.LibGpu.DrawOTag", "mode": "replace" },
    { "overlay": "game", "address": "0x800605A4",
      "target": "RecompOne.Runtime.Sdk.LibGpu.DrawSync", "mode": "replace" },
    { "overlay": "game", "address": "0x80060870",
      "target": "RecompOne.Runtime.Sdk.LibGpu.PutDrawEnv", "mode": "replace" },
    { "overlay": "game", "address": "0x80060990",
      "target": "RecompOne.Runtime.Sdk.LibGpu.PutDispEnv", "mode": "replace" },

    { "overlay": "end", "address": "0x80013D80",
      "target": "RecompOne.Runtime.Sdk.LibGpu.DrawOTag", "mode": "replace" },
    { "overlay": "end", "address": "0x80013B0C",
      "target": "RecompOne.Runtime.Sdk.LibGpu.DrawSync", "mode": "replace" },
    { "overlay": "end", "address": "0x80013DD8",
      "target": "RecompOne.Runtime.Sdk.LibGpu.PutDrawEnv", "mode": "replace" },
    { "overlay": "end", "address": "0x80013EF8",
      "target": "RecompOne.Runtime.Sdk.LibGpu.PutDispEnv", "mode": "replace" },

    // ---- libcdstream --------------------------------------------------------
    //
    // The intro and ending are STR movies streamed off the disc, and this is the
    // library that feeds them. It is a different object from the rest of libcd,
    // so it sits at its own offset: game = open + 0x30AB4, end = open - 0x3A34.
    //
    // The ring layout is what identifies these, and it is the same layout the
    // runtime's LibCdStream already assumes: `slots` 32-byte headers first, then
    // `slots` 2016-byte data blocks. StGetNext computes its data pointer as
    // ring + slots*32 + idx*2016 (visible as idx*63 << 5) and its header pointer
    // as ring + idx*32; StFreeRing divides back by 0x1F8 words to recover idx,
    // requires the slot's status word to be 4, and clears the `n` headers whose
    // count it reads from header+6 -- the STR frame header's sector count.
    //
    // The call sites settle the argument shapes:
    //   0x8001422C  StSetRing(0x800927F0, 0x20)         64 KiB ring, 32 slots
    //               StSetStream(0, 1, 0x0FFFFFFF, 0, 0)
    //   0x80014440  StGetNext(&addr, &header) until it returns 0, then checks
    //               data[0]/data[1] against header+0x14/+0x18 -- the STR header's
    //               copy of the first two bitstream words -- and StFreeRing()s
    //               the slot when they disagree.
    //
    // StClearRing and StUnSetRing have no call sites in any overlay; they are
    // mapped anyway so a raw one can never run against an HLE-managed ring.
    // StSetMask and StGetBackloc are not called either and are not identified.
    { "overlay": "open", "address": "0x8001C584",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StSetRing", "mode": "replace" },
    { "overlay": "open", "address": "0x8001C5DC",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StClearRing", "mode": "replace" },
    { "overlay": "open", "address": "0x8001C62C",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StUnSetRing", "mode": "replace" },
    { "overlay": "open", "address": "0x8001C6CC",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StSetStream", "mode": "replace" },
    { "overlay": "open", "address": "0x8001C7A0",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StFreeRing", "mode": "replace" },
    { "overlay": "open", "address": "0x8001C8A8",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StGetNext", "mode": "replace" },

    { "overlay": "game", "address": "0x8004D038",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StSetRing", "mode": "replace" },
    { "overlay": "game", "address": "0x8004D090",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StClearRing", "mode": "replace" },
    { "overlay": "game", "address": "0x8004D0E0",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StUnSetRing", "mode": "replace" },
    { "overlay": "game", "address": "0x8004D180",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StSetStream", "mode": "replace" },
    { "overlay": "game", "address": "0x8004D254",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StFreeRing", "mode": "replace" },
    { "overlay": "game", "address": "0x8004D35C",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StGetNext", "mode": "replace" },

    { "overlay": "end", "address": "0x80018B50",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StSetRing", "mode": "replace" },
    { "overlay": "end", "address": "0x80018BA8",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StClearRing", "mode": "replace" },
    { "overlay": "end", "address": "0x80018BF8",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StUnSetRing", "mode": "replace" },
    { "overlay": "end", "address": "0x80018C98",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StSetStream", "mode": "replace" },
    { "overlay": "end", "address": "0x80018D6C",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StFreeRing", "mode": "replace" },
    { "overlay": "end", "address": "0x80018E74",
      "target": "RecompOne.Runtime.Sdk.LibCdStream.StGetNext", "mode": "replace" },

    // ---- libapi -------------------------------------------------------------
    //
    // DMACallback(ch, func). On hardware a finished DMA raises IRQ 3 and PSY-Q's
    // interrupt entry reads DICR and calls the channel's callback. A static
    // recompilation has no exception path, so that entry never runs and every
    // DMA callback is dead. It is not obvious that anything is wrong, because
    // the transfers themselves are emulated and complete fine -- only the work
    // the game does *in* the callback goes missing.
    //
    // For the intro that work is the whole picture: the movie's DMA channel 1
    // (MDEC out) callback is the function that calls LoadImage on the decoded
    // frame. Without it the movie decodes 320x240 frames at full rate into RAM
    // and not one of them ever reaches VRAM.
    //
    // Identified by its DICR arithmetic: it indexes a callback table by channel,
    // returns the previous entry, and on install ORs 0x00800000 | (0x01010000 <<
    // ch) into DICR -- master enable plus that channel's enable and flag bits --
    // clearing them again when passed a null callback. The runtime records the
    // table itself and Dma.Complete runs the callback.
    { "overlay": "open", "address": "0x8001EAF0",
      "target": "RecompOne.Runtime.Sdk.LibApi.DMACallback", "mode": "replace" },
    { "overlay": "game", "address": "0x8005FC30",
      "target": "RecompOne.Runtime.Sdk.LibApi.DMACallback", "mode": "replace" },
    { "overlay": "end", "address": "0x8001B0BC",
      "target": "RecompOne.Runtime.Sdk.LibApi.DMACallback", "mode": "replace" }
  ],

  // Diagnostics: annotate generated C# with addresses and disassembly. Very
  // verbose, so keep off unless chasing a specific bad function.
  "debug": false,
  "addressComments": false,
  "disasmComments": false
}
