{
  // King's Field (NTSC-U, SLUS-00158) -- the North American release of
  // King's Field II (JP, SLPS-00069). From Software, 1995.
  // Config schema: tools/RecompOne/RecompOne.Recompiler/Config/ConfigLoader.cs
  // JSON comments and trailing commas are accepted by the loader.
  //
  // NUMBER BASES DIFFER between this file and the CLI:
  //   here : "base" is a hex STRING; "size"/"skip"/"offset"/"lba" are decimal numbers.
  //   CLI  : -size/-skip/-offset are HEX; -lba is decimal.
  "game": {
    "id": "SLUS-00158",
    "name": "KingsField2",
    "output": "../generated"
  },

  "cue": "../disc/KingsField2.cue",

  // The boot executable named by SYSTEM.CNF (SLUS_001.58) is discovered
  // automatically. It is only 2 KiB of code at 0x80010000 -- a loader stub whose
  // job is to pull in one of the three real executables below.
  "funcMap": "funcmaps/main.json",

  // OPEN.EXE, GAME.EXE and END.EXE all load at 0x80011000, so they are mutually
  // exclusive: only one is resident at a time (title/intro, main game, ending).
  // That is exactly what the overlay system is for.
  //
  // ResolveOverlay reads these as RAW FILE BYTES and does not parse the PS-X EXE
  // header, so each needs "skip": 2048 to step over the 0x800-byte header.
  // "base" is the header's text address, read with scripts/extract_file.py.
  "overlays": [
    {
      "name": "open",
      "file": "OPEN.EXE",
      "base": "0x80011000",
      "skip": 2048,
      "funcMap": "funcmaps/open.json"
    },
    {
      "name": "game",
      "file": "GAME.EXE",
      "base": "0x80011000",
      "skip": 2048,
      "funcMap": "funcmaps/game.json"
    },
    {
      "name": "end",
      "file": "END.EXE",
      "base": "0x80011000",
      "skip": 2048,
      "funcMap": "funcmaps/end.json"
    }
  ],

  // CD/COM/*.T and OP/*.S are data and streamed media, not code -- they stay out
  // of the overlay list and are read by the runtime through the CD interface.

  "stubs": [],
  "ignored": [],
  "patches": [],

  // Diagnostics: annotate generated C# with addresses and disassembly. Very
  // verbose, so keep off unless chasing a specific bad function.
  "debug": false,
  "addressComments": false,
  "disasmComments": false
}
