# Copyrighted game data -- never commit these.
disc/*
!disc/README.md

# Recompiler output: derived from the disc, so it is also copyrighted.
generated/

# .NET build artifacts
bin/
obj/

# Tool checkout (cloned, not vendored)
tools/RecompOne/

# Written by the runtime at play time: memory card saves and host settings.
*.sav
settings.json
interface.ini

# Optional runtime asset-replacement packs
packs/

__pycache__/
*.pyc

# ModLoader compiles mods/ at run time and caches the assemblies here.
mods/.cache/

# RateCensus writes its dump here by default (KF2_RATECENSUS_OUT); it is a
# diagnostic reading of one session, not source. One was committed once.
ratecensus.txt

# Working files: extracted disc executables and probe logs.
scratch/
