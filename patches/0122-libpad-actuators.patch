     }
 
     public static void PadSetMainMode(CpuContext c, IMemory m)
@@ -114,6 +129,7 @@ public static class LibPad
             if (v == 0x00) _smallMotorIdx = i;
             else if (v == 0x01) _largeMotorIdx = i;
