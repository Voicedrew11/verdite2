+        ZBandMinSz = float.MaxValue; ZBandMaxSz = 0f;
+        ZBandMinEntry = int.MaxValue; ZBandMaxEntry = -1;
+    }
 
     /// <summary>A census of the frame's <i>large</i> polygons, in the order the
     /// ordering table submitted them, with the depth each one recovered. It exists
@@ -264,6 +287,119 @@ public static class GteDepth
     /// Believing its SZ puts the sky in front of the world.</summary>
     public static int OtEntry = -1;
 
+    /// <summary>How far below its <i>position-predicted</i> depth a primitive must
+    /// project to count as parked background. Measured against a skybox that, for
+    /// this game, is <b>not near</b> — its recovered SZ is mid-range (thousands),
+    /// overlapping real geometry — but is linked at the extreme far end of the
+    /// table, so its position predicts the frame's farthest depth while it projects
+    /// only a fraction of it. Real geometry sits at or above its predicted depth,
+    /// far outside this margin, so it is never parked. Measured across five outdoor
+    /// windows the sky ran at ≤0.55 of predicted and the nearest real primitive at
+    /// ≥1.14, so the cut sits comfortably between. Calibrate against
+    /// <c>KF2_ZBUFFER_PROBE=2</c>.</summary>
+    public const float SkyParkMargin = 0.7f;
+
+    /// <summary>Primitives linked fewer than this many nodes from the far end of
+    /// the table never feed the <see cref="FarSz"/> accumulation. The backdrop
+    /// links at the extreme far end and spread past node 64 in the fixed-band
+    /// attempt, so 512 covers it with margin; excluding genuinely far-clamped
+    /// geometry here only lowers the scale, which is the safe direction — real
+    /// geometry then projects at or above its predicted depth more easily and is
+    /// never over-parked.</summary>
+    public const int SkyScaleBand = 512;
+
+    /// <summary>The depth attribute a parked primitive carries instead of its
+    /// recovered SZ: SZ3 saturated, the deepest window depth the GTE can emit.
+    /// The shader maps it just under the cleared depth, so a parked fragment
+    /// passes against empty space, writes a depth nothing real sits behind, and
+    /// ties with other parked fragments — painter's order by arithmetic rather
+    /// than by leaving the depth test, which would change the hardware backend's
+    /// batch key and flush at every crossing between parked and tested
+    /// geometry.</summary>
+    public const float ParkedFarSz = 65535f;
+
+    /// <summary>The far-world depth scale the park test measures against: the
+    /// largest recovered depth of any full-depth primitive linked outside
+    /// <see cref="SkyScaleBand"/>, held sticky for the overlay session — a
+    /// near-only frame must not shrink it, or the backdrop's own mid-range SZ
+    /// beats the margin and the sky draws over the terrain behind it. Reset to 0
+    /// when an overlay loads (static constructor). Published one walk late beside
+    /// <see cref="OtLength"/>; a HUD-only walk changes nothing.</summary>
+    public static float FarSz;
+    static float _farSzAccum;
+    static float _farSzWalk;
+
+    /// <summary>The last completed walk's own maximum, kept beside the sticky
+    /// scale so the probe can show a near-only walk collapsing while the scale
+    /// holds.</summary>
+    public static float FarSzWalk => _farSzWalk;
+
+    static GteDepth() =>
+        Events.Event.AddListener<Events.OverlayLoadedEvent>(_ => FarSz = 0f);
+
+    /// <summary>Publish the walk's depth scale for the next one, beside the
+    /// <see cref="OtLength"/> publish in every <c>DrawOTag</c>. Sticky: the scale
+    /// only ever rises within an overlay session.</summary>
+    public static void PublishFarSz()
+    {
+        if (_farSzAccum > FarSz) FarSz = _farSzAccum;
+        if (_farSzAccum > 0f) _farSzWalk = _farSzAccum;
+        _farSzAccum = 0f;
+    }
+
+    /// <summary>The skybox by its real signature — <b>linked far ahead of what its
+    /// depth warrants</b>. For real geometry the table position and the recovered
+    /// depth agree: a low <see cref="OtEntry"/> (the far end) carries a high SZ. The
+    /// game's backdrop violates that — it is linked at the extreme far end, so its
+    /// position predicts the far-world depth (<see cref="FarSz"/>), but it
+    /// projects only mid-range. So the test is a disagreement, not a "near" cut: the
+    /// position predicts <c>FarSz × (1 − OtEntry / OtLength)</c>, and a primitive
+    /// projecting below <see cref="SkyParkMargin"/> of that is the backdrop and is
+    /// parked at <see cref="ParkedFarSz">the far plane</see> — it stays inside the
+    /// depth test but at a depth nothing real sits behind, so painter's order
+    /// survives by arithmetic rather than by leaving the test, which would move
+    /// the hardware backend's batch key and flush at every crossing with tested
+    /// geometry. A genuinely-distant wall carries at least its predicted depth
+    /// and keeps testing; nothing in the near half predicts a far depth, so
+    /// nothing there is ever parked.
+    ///
+    /// Called once per triangle from both rasterizers, only while
+    /// <see cref="ZBuffer"/> is on, so it also carries the accumulation of
+    /// <see cref="FarSz"/>. All-or-nothing: a primitive missing a corner's depth
+    /// is never the sky and is left to the normal test.</summary>
+    public static bool IsBackgroundPark(float wa, float wb, float wc)
+    {
+        float minSz = MathF.Min(wa, MathF.Min(wb, wc));
+        float maxSz = MathF.Max(wa, MathF.Max(wb, wc));
+
+        // Track the far world depth from real geometry only: outside the far band, so
+        // the backdrop's own mid-depth SZ can never become the scale it is measured
+        // against. Parked-or-not is deliberately not the gate — bootstrapping on the
+        // test's own output would let walk 1 poison the scale in an area whose sky is
+        // deeper than every wall.
+        if (minSz > 0f && maxSz > _farSzAccum && OtEntry >= SkyScaleBand)
+            _farSzAccum = maxSz;
+
+        // Outside a walk, no full depth, or no scale/length yet: safer to test.
+        if (OtEntry < 0 || OtLength <= 0) return false;
+        if (minSz <= 0f || FarSz <= 0f) return false;
+
+        // The depth this table position would carry if position and SZ agreed. The
+        // backdrop, linked at the far end, projects far below it; real geometry sits
+        // at or above it. maxSz (the farthest corner) keeps a near-to-far spanning
+        // wall from ever being mistaken for the flat backdrop.
+        float predicted = FarSz * (1f - (float)OtEntry / OtLength);
+        bool park = maxSz < predicted * SkyParkMargin;
+        if (park)
+        {
+            if (minSz < ZBandMinSz) ZBandMinSz = minSz;
+            if (maxSz > ZBandMaxSz) ZBandMaxSz = maxSz;
+            if (OtEntry < ZBandMinEntry) ZBandMinEntry = OtEntry;
+            if (OtEntry > ZBandMaxEntry) ZBandMaxEntry = OtEntry;
+        }
+        return park;
+    }
+
     /// <summary>How many entries the last completed walk had, so an entry can be
     /// read back as the OTZ the game linked at: <c>otz = OtLength - 1 - OtEntry</c>.
     /// Published one walk late, which is what makes it free.</summary>
