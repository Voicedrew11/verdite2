@@ -235,7 +235,30 @@ public static class GteDepth
     /// back, so <see cref="ZRejects"/> stays at zero there.</summary>
     public static long ZTris, ZSkipped, ZRejects;
 
-    public static void ResetZCounters() => ZTris = ZSkipped = ZRejects = 0;
+    /// <summary>Triangles handed back to painter's order because they were the
+    /// backdrop — linked far ahead of what their depth warrants — see
+    /// <see cref="IsBackgroundPark"/>. They count here rather than in
+    /// <see cref="ZTris"/> or <see cref="ZSkipped"/>, so the tested rate keeps
+    /// meaning what it meant.</summary>
+    public static long ZBand;
+
+    /// <summary>The recovered SZ range of the primitives parked as background this
+    /// window, so the probe can show the backdrop sitting below the depth its table
+    /// position predicts. Empty range while nothing parked.</summary>
+    public static float ZBandMinSz = float.MaxValue, ZBandMaxSz;
+
+    /// <summary>The ordering-table range the parked primitives spanned this
+    /// window, so the probe can show how far along the far end of the table the
+    /// backdrop spreads — the scatter whose crossings with tested geometry used
+    /// to be paid for in batch flushes. Empty while nothing parked.</summary>
+    public static int ZBandMinEntry = int.MaxValue, ZBandMaxEntry = -1;
+
