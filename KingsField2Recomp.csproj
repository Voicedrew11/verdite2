<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>KingsField2</AssemblyName>
        <RootNamespace>KingsField2</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="tools/RecompOne/RecompOne.Runtime/RecompOne.Runtime.csproj" />
    </ItemGroup>

    <!--
      The recompiler emits C# into generated/, and hand-written function
      replacements live in patches/. Both sit under the project root, so the
      SDK's default item globs pick them up automatically. Adding an explicit
      Compile Include for them causes NETSDK1022 (duplicate Compile items).

      That same default glob is why tools/ must be removed explicitly: the
      RecompOne checkout is nested inside this project directory, so without
      this the build would compile RecompOne's own sources and the AssemblyInfo
      files under its obj/, producing CS0579 duplicate-attribute errors.
      RecompOne.Runtime is consumed through the ProjectReference above instead.
    -->
    <ItemGroup>
        <Compile Remove="tools/**" />
        <EmbeddedResource Remove="tools/**" />
        <None Remove="tools/**" />
    </ItemGroup>

    <!--
      mods/ is RecompOne's ModLoader root, not project source. Its .cs files are
      read from disk and compiled by Roslyn at run time, so the default glob must
      not also compile them into this assembly: that would produce a second, inert
      copy of every mod type and let the two drift apart.

      Anything that must always be on does NOT belong here. It goes in patches/
      and attaches through HookManager; patches/FramePacing.cs is the example.
    -->
    <ItemGroup>
        <Compile Remove="mods/**" />
        <EmbeddedResource Remove="mods/**" />
        <None Remove="mods/**" />
    </ItemGroup>

    <!--
      mcp/ is a separate program (an MCP server for agent hosts), not part of the
      game assembly. Nested under this directory its sources and obj/ AssemblyInfo
      would be picked up by the default globs — the CS0579 trap tools/** and
      mods/** are already removed for.
    -->
    <ItemGroup>
        <Compile Remove="mcp/**" />
        <EmbeddedResource Remove="mcp/**" />
        <None Remove="mcp/**" />
    </ItemGroup>

</Project>
