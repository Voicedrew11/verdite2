<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>KingsField2</AssemblyName>
        <RootNamespace>KingsField2</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="tools/RecompOne/RecompOne.Runtime/RecompOne.Runtime.csproj" />
    </ItemGroup>

    <!--
      The recompiler emits C# into generated/. That directory is gitignored and does
      not exist until the first successful recompile, so glob it rather than listing
      files, and tolerate its absence.
    -->
    <ItemGroup>
        <Compile Include="generated/**/*.cs" />
    </ItemGroup>

</Project>
