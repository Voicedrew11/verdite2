<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The shipped executable: Verdite Core's launcher (tools/verdite-core/launcher)
      under this port's names, with Program.cs handing it the one record it needs.
      Everything else - the payload, the version stamp, the build options that must
      match KingsField2Recomp.csproj - is in Launcher.targets, shared with the other
      ports. See docs/PACKAGING.md.
    -->
    <PropertyGroup>
        <AssemblyName>Verdite2</AssemblyName>
        <RootNamespace>Verdite2.Launcher</RootNamespace>
        <VerditeAppId>verdite2</VerditeAppId>
        <VerditeEnvPrefix>VERDITE2_</VerditeEnvPrefix>

        <!--
          Windows reads the icon out of the executable itself, so it has to be set
          here rather than by the packaging. See packaging/shared/README.md.
        -->
        <ApplicationIcon>../packaging/shared/verdite2.ico</ApplicationIcon>
    </PropertyGroup>

    <Import Project="../tools/verdite-core/launcher/Launcher.targets" />

</Project>
